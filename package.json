{
  "name": "lifecharge",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Based Battery Health Prediction and Predictive Maintenance System for Electric Vehicles",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:ml": "cd ml-service && python run.py",
    "build:frontend": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:ml": "python -m compileall ml-service/app",
    "test": "npm run test:frontend && npm run test:backend && npm run test:ml",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build"
  },
  "keywords": [
    "ev",
    "battery-health",
    "machine-learning",
    "predictive-maintenance",
    "explainable-ai"
  ],
  "author": "BALASURYA45",
  "license": "MIT"
}
